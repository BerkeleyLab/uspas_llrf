`ifdef FSETTING_ALSU
    `define DSP_CLK_CYCLE       8.7206      // F_CLK = 500 * 11 / 12 / 4 = 114.58MHz
    `define NUM_DDS             4
    `define DEN_DDS             11
    `define CIC_BASE_PERIOD     22          // multiple of 11, > 2*N_CH, >= cordic delay
    `define AMP_SETP_GAIN       4.8312645   // calculated RX gain
    `define RX_LO_PHS           19'd191879  // 131.753 deg
    `define TX_LO_PHS           -19'd47662  // -32.727 deg
    `define SHIFT_BASE          7
    `define SHIFT_INLK          12
`elsif FSETTING_USPAS
    `define DSP_CLK_CYCLE       8.69565     // F_CLK = 115 MHz
    `define NUM_DDS             4
    `define DEN_DDS             23
    `define CIC_BASE_PERIOD     23          // multiple of 23, > 2*N_CH, >= cordic delay
    `define AMP_SETP_GAIN       5.66806     // calculated RX gain
    `define RX_LO_PHS           19'd95602   // 65.645
    `define TX_LO_PHS           19'd250746  // 172.174 deg
    `define SHIFT_BASE          7
    `define SHIFT_INLK          12
`elsif FSETTING_LEMP
    `define DSP_CLK_CYCLE       8.40336     // F_CLK = 119.0 MHz
    `define NUM_DDS             3
    `define DEN_DDS             14
    `define CIC_BASE_PERIOD     28          // multiple of 14, > 2*N_CH, >= cordic delay
    `define AMP_SETP_GAIN       6.22830     // calculated RX gain
    `define RX_LO_PHS           19'd115720  // 79.459 deg
    `define TX_LO_PHS           19'd187245  // 128.571 deg
    `define SHIFT_BASE          7
    `define SHIFT_INLK          13
`endif

`define CORDIC_GAIN     1.64676
`define LO_AMP          74840    // must < (2^17 / `CORDIC_GAIN)
