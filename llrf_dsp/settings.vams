`ifdef FSETTING_ALSU
    `define DSP_CLK_CYCLE       8.7206      // F_CLK = 500 * 11 / 12 / 4 = 114.58MHz
    `define NUM_DDS             4
    `define DEN_DDS             11
    `define CIC_BASE_PERIOD     22          // multiple of 11, > 2*N_CH, >= cordic delay
    `define P_PHASE_SHIFT       19'd190650  // 4/11 * (1<<19)
    `define N_PHASE_SHIFT       19'd333637  // (1 - 4/11) * (1<<19)
    `define CIC_PHASE_COMP      19'd11913   // CIC phase offset: 8.18 deg
    `define RX_AMP_GAIN         2.9366      // for feedback, measured
    `define RX_PHS_OFF          19'd1107    // 0.76 deg / 360 * (1<<19), measured
    `define DDC_AMP_GAIN        2.8424      // for monitor, measured  (see fdownconvert)
    `define DDC_PHS_GAIN        0           // deg
    `define OPEN_PHS_GAIN       0.0         // deg, measured
    `define SHIFT_BASE          7
    `define SHIFT_INLK          12
`elsif FSETTING_SIRIUS
    `define DSP_CLK_CYCLE       8.3478      // F_CLK = 500 * 23/24/4 = 119.8 MHz
    `define NUM_DDS             4
    `define DEN_DDS             23
    `define CIC_BASE_PERIOD     23          // multiple of 23, > 2*N_CH, >= cordic delay
    `define P_PHASE_SHIFT       19'd0       // 4/23 * (1<<19)
    `define N_PHASE_SHIFT       19'd433107  // (1 - 4/23) * (1<<19)
    `define CIC_PHASE_COMP      19'd643957  // CIC phase offset: 82.17 deg
    `define RX_AMP_GAIN         3.4426      // for feedback, measured
    `define RX_PHS_OFF          19'd437533  // -59.57 deg / 360 * (1<<19), measured
    `define DDC_AMP_GAIN        3.3396      // for monitor, measured
    `define DDC_PHS_GAIN        62.60869    // `NUM_DDS/`DEN_DDS * 360, 1 cycle
    `define OPEN_PHS_GAIN       0.0         // deg, measured
    `define SHIFT_BASE          7
    `define SHIFT_INLK          12
`elsif FSETTING_USPAS
    `define DSP_CLK_CYCLE       8.69565     // F_CLK = 115 MHz
    `define NUM_DDS             4
    `define DEN_DDS             23
    `define CIC_BASE_PERIOD     23          // multiple of 23, > 2*N_CH, >= cordic delay
    `define P_PHASE_SHIFT       19'd0       // 4/23 * (1<<19)
    `define N_PHASE_SHIFT       19'd433107  // (1 - 4/23) * (1<<19)
    `define CIC_PHASE_COMP      19'd643957  // CIC phase offset: 82.17 deg
    `define RX_AMP_GAIN         3.4426      // for feedback, measured
    `define RX_PHS_OFF          19'd437533  // -59.57 deg / 360 * (1<<19), measured
    `define DDC_AMP_GAIN        3.3396      // for monitor, measured
    `define DDC_PHS_GAIN        62.60869    // `NUM_DDS/`DEN_DDS * 360, 1 cycle
    `define OPEN_PHS_GAIN       0.0         // deg, measured
    `define SHIFT_BASE          7
    `define SHIFT_INLK          12
`elsif FSETTING_LEMP
    `define DSP_CLK_CYCLE       8.40336     // F_CLK = 119.0 MHz
    `define NUM_DDS             3
    `define DEN_DDS             14
    `define CIC_BASE_PERIOD     28          // multiple of 14, > 2*N_CH, >= cordic delay
    `define P_PHASE_SHIFT       19'd0       // measured
    //`define P_PHASE_SHIFT       19'd37458       // measured
    `define N_PHASE_SHIFT       19'd0
    `define CIC_PHASE_COMP      19'd18710       // CIC phase offset, 12.84 deg
    `define RX_AMP_GAIN         3.78241     // for feedback, measured
    `define RX_PHS_OFF          19'd265439  // -177.74 deg / 360 * (1<<19), measured
    `define DDC_AMP_GAIN        3.66673     // for monitor, measured
    `define DDC_PHS_GAIN        102.85714   // 6 cycles: (6 * 3/14 * 360 % 360), deg
    //`define OPEN_PHS_GAIN       25.77       // deg, measured
    `define OPEN_PHS_GAIN       0       // deg, measured
    `define SHIFT_BASE          7
    `define SHIFT_INLK          13
`endif

`define CORDIC_GAIN     1.64676
`define LO_AMP          74840    // must < (2^17 / `CORDIC_GAIN)
