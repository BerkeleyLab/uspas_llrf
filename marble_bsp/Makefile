include ../dir_list.mk
include $(TOP)settings.mk
include $(BUILD_DIR)/top_rules.mk

IP_NAME     = marble_bsp
TEST_BENCH  = $(IP_NAME)_tb
CHECKS      = $(IP_NAME)_check

# Include directories only: the sources are listed explicitly in build.mk,
# with no -y library search and no dependency scan, as in designs/rules.mk.
# The registers are generated by uspas_llrf/regmap.py, not newad.
VFLAGS_DEP += -I$(BADGER_DIR)
VFLAGS_DEP += -I$(SERIAL_IO_DIR)
VFLAGS_DEP += -I$(DSP_DIR)/hosted
VFLAGS_DEP += -I$(BEDROCK_DIR)/localbus
VFLAGS_DEP += -I$(SERIAL_IO_DIR)/EVG_EVR
VFLAGS_DEP += $(SYNTH_OPT)
VFLAGS += $(VFLAGS_DEP)
VFLAGS += -g2012

.DEFAULT_GOAL = all
.PHONY: all clean
all: $(TEST_BENCH) $(CHECKS)

##### build.mk
include build.mk

CLEAN += $(TEST_BENCH)
CLEAN += $(RTEFI_CLEAN)

include $(BUILD_DIR)/bottom_rules.mk
